# =============================================================================
# Docker build context ignore list.
# The management/backend/Dockerfile is built from the repo root so it can copy
# integrations/alphavantage/. Exclude everything not needed for that build.
# =============================================================================

# VCS and editor
.git/
.gitignore
.gitattributes
.vscode/
.idea/

# Python build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.env
.coverage
htmlcov/
dist/
build/

# Node / Next.js (for frontend Docker build we only need management/frontend)
**/node_modules/
**/.next/
**/out/

# Docs, test fixtures, etc. (not needed in the backend image)
docs/
notebooks/
samples/
inspiration/
terminals/

# Unrelated large sub-projects that shouldn't be pulled into the backend image
management/frontend/node_modules/
management/frontend/.next/
flink-jobs/.venv/
flink-jobs/target/
flink-jobs-java/target/
templates/*/node_modules/

# Kubernetes manifests are applied separately
kubernetes/

# Local scratch files
*.log
*.tmp
*.bak
